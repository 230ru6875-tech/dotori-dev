{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strategybar",
  "account_id": "6ead7cb11a99b93959c5437fbcd01eb7",
  "main": "cloudflare/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "strategybar",
      "database_id": "REPLACE_AFTER_CLOUDFLARE_CONNECTION"
    }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "OPENAI_ROUTINE_MODEL": "gpt-5.6-luna",
    "OPENAI_DEEP_MODEL": "gpt-5.6-sol",
    "AI_DAILY_LIMIT": "24",
    "BROKER_QUOTE_MAX_AGE_MS": "420000"
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_QUOTES", "class_name": "LiveQuotes" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveQuotes"] }]
}
